{
  "name": "drew-test/repo-schedules-test",
  "schedules": {
    "launch-smoke-test": {
      "skill": "file:plugins/launch-smoke-test",
      "cron": "0 9 1 12 *",
      "environment": "drew-test-env",
      "timezone": "Europe/London",
      "baseBranch": "main",
      "inputs": {
        "LOG_FILE": "SMOKE-LOG.md",
        "BRANCH_PREFIX": "launch-smoke-test"
      },
      "description": "Parked: fires once a year at 09:00 on 1 December so it does not run during testing."
    }
  }
}
